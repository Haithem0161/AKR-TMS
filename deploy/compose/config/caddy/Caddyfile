# The edge. TLS with the certificate the bank's CA issued; nothing is fetched and nothing is renewed
# from here.
{
	admin off
	auto_https off
}

https://{$AKR_PUBLIC_HOST}, https://127.0.0.1 {
	tls /run/akr/tls/edge.crt /run/akr/tls/edge.key

	# The container health check. It says that the edge answers, nothing about what is behind it.
	handle /edge-health {
		respond 204
	}

	# The directory webhook is reachable only while the directory pack is rendered, which adds its route.
	handle /api/v1/directory/events {
		respond 404
	}

	handle /api/* {
		reverse_proxy akr-api:8080
	}

	# Presigned downloads, through the guard. Reading only.
	@download {
		path /files/*
		method GET HEAD
	}
	handle @download {
		uri strip_prefix /files
		reverse_proxy s3guard:9000
	}
	handle /files/* {
		respond 405
	}

	# The bank's name, written at installation. The sign-in screen reads it before anyone has signed in.
	handle /branding.json {
		root * /srv/branding
		header Cache-Control no-cache
		file_server
	}

	# The web application: a static bundle. Nothing in it is fetched from another origin.
	handle {
		root * /srv/www
		header {
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'"
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options nosniff
			Referrer-Policy no-referrer
			Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		}
		route {
			try_files {path} /index.html
			header /index.html Cache-Control no-store
			header /assets/* Cache-Control "public, max-age=31536000, immutable"
			file_server
		}
	}
}
