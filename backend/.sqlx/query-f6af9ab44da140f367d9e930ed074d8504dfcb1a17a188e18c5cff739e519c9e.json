  "query": "SELECT id, topic, payload, created_at, available_at, attempts\n             FROM admin.outbox\n             WHERE dispatched_at IS NULL AND available_at <= now() AND attempts < $2 AND topic = ANY($1)\n             ORDER BY available_at\n             LIMIT 1\n             FOR UPDATE SKIP LOCKED",
