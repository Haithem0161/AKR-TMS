{
  "openapi": "3.1.0",
  "info": {
    "title": "AKR-TMS API",
    "description": "Transaction monitoring, screening and case management for one bank.",
    "license": {
      "name": "UNLICENSED",
      "identifier": "UNLICENSED"
    },
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "/",
      "description": "This installation"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "infra"
        ],
        "summary": "Liveness",
        "description": "The process is up. It does not look at any dependency: a database blip must not get a healthy process\nrestarted.",
        "operationId": "healthz",
        "responses": {
          "200": {
            "description": "The process is up",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/readyz": {
      "get": {
        "tags": [
          "infra"
        ],
        "summary": "Readiness",
        "description": "Whether this instance can take requests: the database answers, its schema is not older than this\nbuild, and Valkey answers. The body holds names and booleans only.",
        "operationId": "readyz",
        "responses": {
          "200": {
            "description": "Ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "code",
          "correlation_id"
        ],
        "properties": {
          "type": {
            "type": "string",
            "description": "URI of the problem type."
          },
          "title": {
            "type": "string",
            "description": "Fixed English summary of the code."
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "code": {
            "type": "string",
            "description": "The field a client branches on (API.md section 6)."
          },
          "errors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "description": "The places and rules that failed. Present for `E_VALIDATION`, and for a 400 or 409 that has a reason."
          },
          "current_version": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "description": "The version the resource has now. Present for `E_VERSION_CONFLICT`."
          },
          "correlation_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Readiness": {
        "type": "object",
        "required": [
          "status",
          "checks"
        ],
        "properties": {
          "status": {
            "type": "string",
            "description": "`ready` when every check passed, else `not_ready`.",
            "example": "ready"
          },
          "checks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReadinessCheck"
            }
          }
        }
      },
      "ReadinessCheck": {
        "type": "object",
        "required": [
          "name",
          "ok"
        ],
        "properties": {
          "name": {
            "type": "string",
            "example": "database"
          },
          "ok": {
            "type": "boolean"
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "description": "One failure of a request, located by JSON pointer (RFC 6901). An empty pointer means the request as a\nwhole: the reason behind a 400 or a 409 travels this way.",
        "required": [
          "pointer",
          "code",
          "params"
        ],
        "properties": {
          "pointer": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stable machine code of the rule, e.g. `required`, `not_a_cron`, `governed`."
          },
          "params": {
            "type": "object",
            "description": "The facts the rule's sentence needs that only the server holds."
          }
        }
      }
    },
    "responses": {
      "ProblemResponse": {
        "description": "Error response (RFC 7807)",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problem"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "bearer_token": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "A client-credentials token of an integration."
      },
      "session_cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "akr_session",
        "description": "The browser session. An unsafe request also needs the X-CSRF-Token header."
      },
      "stepup_assertion": {
        "type": "apiKey",
        "in": "header",
        "name": "X-StepUp-Assertion",
        "description": "A single-use proof of a fresh second factor, for the operations marked step-up."
      }
    }
  },
  "tags": [
    {
      "name": "infra",
      "description": "Liveness and readiness"
    }
  ]
}
